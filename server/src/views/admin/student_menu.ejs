<!DOCTYPE html>
<html>
<head>
        <link href="https://chemu-app.github.io/chemu-admin/src/css/basePage.css" rel="stylesheet"/>
        <link href="https://chemu-app.github.io/chemu-admin/src/css/fonts.css" rel="stylesheet"/>
</head>
<body class="column">
<div class="pageHead">
                <p class="headerTitle Nunito_900Black">Select An Option</p>
        </div>
	<div class="mainContent">
	<p>Total Student Count: <%= count %></p>
	<% students.forEach(student => { -%>
	<div class="itemCard">
                        <div class="styleBar"></div>
                        <div class="cardInfo">
		<p class="cardTitle Nunito_700Bold"><%= student.name %></p>
		<p class="cardSubtitle Nunito_800ExtraBold"><%= student.email %></p>
		<p>
			Course Count: <%= student?.courses?.length ?? 0 %><br />
			Badge Count: <%= student?.badges?.length ?? 0 %><br />
			Reward Count: <%= student?.rewards?.length ?? 0 %><br />
		</p>
		<form method="POST" action="//52.206.48.241/admin/student/edit">
			<input type="hidden" name="token" value="<%= token %>" />
			<input type="hidden" name="id" value="<%= id %>" />
			<input type="hidden" name="email" value="<%= email %>" />
			<input type="hidden" name="role" value="<%= role %>" />
			<input type="hidden" name="count" value="<%= count %>" />
			<input type="hidden" name="page" value="<%= page %>" />
			<input type="hidden" name="pageSize" value="<%= pageSize %>" />
			<input type="hidden" name="studentid" value="<%= student.id %>" />
			<div class="row">
                                        <input class="inputButton" type="submit" name="action" value="Change E-Mail"/>
                                        <input class="inputButton" type="submit" name="action" value="Change Name" />
                                        <input class="inputButton" type="submit" name="action" value="Change Password" /></div>
		</form>
	</div></div>

	<% }); -%>
	</div>
	<form method="POST" action="//52.206.48.241/admin/menu/base" class="navBar">
                <input type="hidden" name="token" value="<%= token %>" />
                <input type="hidden" name="id" value="<%= id %>" />
                <input type="hidden" name="email" value="<%= email %>" />
                <input type="hidden" name="role" value="<%= role %>" />
                <input class="navBarOption" type="submit" name="action" value="TEACHERS" />
                <input class="navBarOption" type="submit" name="action" value="STUDENTS" />
                <input class="navBarOption" type="submit" name="action" value="COURSES" />
                <input class="navBarOption" type="submit" name="action" value="LOG OUT" />
        </form>

</body>
</html>
