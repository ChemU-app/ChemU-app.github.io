<!DOCTYPE html>
<html>
<head>
        <link href="https://chemu-app.github.io/chemu-admin/src/css/basePage.css" rel="stylesheet"/>
        <link href="https://chemu-app.github.io/chemu-admin/src/css/fonts.css" rel="stylesheet"/>
</head>
<body>
	<div class="pageHead">
                <p class="headerTitle Nunito_900Black">Select An Option</p>
        </div>
        <div class="mainContent">
	<p>Total Course Count: <%= count %></p>
	<% courses.forEach(course => { -%>
	<div class="itemCard">
                        <div class="styleBar"></div>
                        <div class="cardInfo">
                <p class="cardTitle Nunito_700Bold"><%= course.name %></p>
		<p class="cardSubtitle Nunito_800ExtraBold">
			Section Number: <%= course.cclass.sectionNumber %></p>
		<p>
			Section Meeting Times: <%= course.cclass.meetingTimes %>
		</p>
		<p>Class Code: <%= course.cclass.code %></p>
		<p>Student Count: <%= course?.students?.length ?? 0 %><br /></p>
		<form method="POST" action="//52.206.48.241/admin/course/edit">
			<input type="hidden" name="token" value="<%= token %>" />
			<input type="hidden" name="id" value="<%= id %>" />
			<input type="hidden" name="email" value="<%= email %>" />
			<input type="hidden" name="role" value="<%= role %>" />
			<input type="hidden" name="count" value="<%= count %>" />
			<input type="hidden" name="page" value="<%= page %>" />
			<input type="hidden" name="pageSize" value="<%= pageSize %>" />
			<input type="hidden" name="courseid" value="<%= course.id %>" />
		</form>
	</div></div>
	<% }); -%>
<form method="POST" action="//52.206.48.241/admin/menu/base" class="navBar">
                <input type="hidden" name="token" value="<%= token %>" />
                <input type="hidden" name="id" value="<%= id %>" />
                <input type="hidden" name="email" value="<%= email %>" />
                <input type="hidden" name="role" value="<%= role %>" />
                <input class="navBarOption" type="submit" name="action" value="TEACHERS" />
                <input class="navBarOption" type="submit" name="action" value="STUDENTS" />
                <input class="navBarOption" type="submit" name="action" value="COURSES" />
                <input class="navBarOption" type="submit" name="action" value="LOG OUT" />
        </form>

</body>
</html>
