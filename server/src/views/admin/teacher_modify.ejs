<!DOCTYPE html>
<html>
<head>
        <link href="https://chemu-app.github.io/chemu-admin/src/css/basePage.css" rel="stylesheet"/>
        <link href="https://chemu-app.github.io/chemu-admin/src/css/fonts.css" rel="stylesheet"/>

</head>
<body>
	<div class="pageHead">
		<p class="headerTitle Nunito_900Black">Modify <%= action %></p>
	</div>
	<div class="mainContent">
		<h3>Teacher Name: <%= teacher.name %></h3>
		<p>Teacher E-Mail: <%= teacher.email %></p><br />
		<form method="POST" action="//52.206.48.241/admin/teacher/modify">
			<input type="hidden" name="token" value="<%= token %>" />
			<input type="hidden" name="id" value="<%= id %>" />
			<input type="hidden" name="email" value="<%= email %>" />
			<input type="hidden" name="role" value="<%= role %>" />
			<input type="hidden" name="variable" value="<%= variable %>" />
			<input type="hidden" name="teacherid" value="<%= teacherid %>" />
			<label class="Nunito_800ExtraBold">New Value:</label><br />
			<input class="textInput Outfit_400Regular" type="password" name="newval" required/><br />
			<label class="Nunito_800ExtraBold">Same Value:</label><br />
			<input class="textInput Outfit_400Regular" type="password" name="subval" required/><br />
			<div class="row">
				<input class="inputButton Nunito_800ExtraBold" type="submit" name="action" value="Cancel"/>
				<input type="submit" name="action" value="Change" />
			</div>
		</form>
	</div>
	<form method="POST" action="//52.206.48.241/admin/menu/base" class="navBar">
                <input type="hidden" name="token" value="<%= token %>" />
                <input type="hidden" name="id" value="<%= id %>" />
                <input type="hidden" name="email" value="<%= email %>" />
                <input type="hidden" name="role" value="<%= role %>" />
                <input class="navBarOption" type="submit" name="action" value="TEACHERS" />
                <input class="navBarOption" type="submit" name="action" value="STUDENTS" />
                <input class="navBarOption" type="submit" name="action" value="COURSES" />
                <input class="navBarOption" type="submit" name="action" value="LOG OUT" />
        </form>
</body>
</html>
