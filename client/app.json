{
  "expo": {
    "name": "ChemU",
    "slug": "chemu-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "baseUrl": "/"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chemu",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.chemu",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F7FF"
      },
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      [
      	"expo-splash-screen",
      	{
      		"backgroundColor": "#F8F7FF",
		"image":"./assets/splash-icon.png",
		"imageWidth":"200"
      	}
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "52861659-3cf1-4a01-bbb2-321ae9dc7081"
      }
    },
    "owner": "intellitraining"
  }
}
